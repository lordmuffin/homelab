# Production Environment Configuration Example
# Copy this file to terraform.tfvars and fill in your values

# Required: Rackspace Spot authentication token
# rackspace_spot_token = "your-rackspace-spot-token"

# Cluster Configuration
prod_cloudspace_name = "prod-homelab"
region              = "us-central-ord-1"
kubernetes_version  = "1.31.1"
cni                = "cilium"

# Optional: Slack webhook for preemption notifications
# preemption_webhook = "https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK"

# General Worker Nodes - Adjust based on your workload requirements
general_worker_server_class   = "gp.vs1.xlarge-ord"    # 4 vCPU, 16GB RAM
general_worker_bid_price      = 0.025                   # $0.025/hour
general_worker_min_nodes      = 3                       # Minimum for HA
general_worker_max_nodes      = 8                       # Scale up capacity
general_worker_desired_nodes  = 4                       # Starting point

# Memory-Optimized Worker Nodes - For data processing workloads
memory_worker_server_class    = "mem.vs1.large-ord"     # 8 vCPU, 32GB RAM
memory_worker_bid_price       = 0.035                   # $0.035/hour
memory_worker_min_nodes       = 1                       # At least one for data workloads
memory_worker_max_nodes       = 4                       # Scale up for heavy processing
memory_worker_desired_nodes   = 2                       # Start with two

# GPU Worker Nodes - For ML/AI workloads (set to 0 if not needed)
gpu_worker_server_class       = "gpu.vs1.large-ord"     # GPU-enabled instance
gpu_worker_bid_price          = 0.15                    # $0.15/hour (GPU premium)
gpu_worker_min_nodes          = 0                       # No minimum (optional workloads)
gpu_worker_max_nodes          = 2                       # Limited GPU budget
gpu_worker_desired_nodes      = 0                       # Start with none, scale as needed

# Security Configuration
enable_network_policies = true

# Resource Tagging
common_labels = {
  "managed-by"   = "terraform"
  "team"         = "platform"
  "cost-center"  = "infrastructure"
  "environment"  = "production"
}

additional_tags = {
  "backup"       = "daily"
  "monitoring"   = "enabled"
  "compliance"   = "required"
}