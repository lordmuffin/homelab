# Development environment configuration
# Copy this file to dev.env and customize for your local development setup

# ThermoWorks API (use mock mode for development)
THERMOWORKS_API_KEY=dev-fake-api-key-mock-mode-enabled
MOCK_MODE=true

# Home Assistant (local development instance)
HOMEASSISTANT_URL=http://localhost:8123
HOMEASSISTANT_TOKEN=dev-long-lived-access-token

# Database (development PostgreSQL)
DB_USERNAME=dev_grill_user
DB_PASSWORD=dev-password-123
POSTGRES_DB=grill-stats-dev

# Redis (development instance)
REDIS_PASSWORD=dev-redis-password

# Flask Development Settings
SECRET_KEY=dev-flask-secret-key-not-for-production
FLASK_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG

# Development Admin User
ADMIN_EMAIL=dev@localhost
ADMIN_PASSWORD=dev123
ADMIN_NAME=Development Admin

# Development Sync Settings (faster intervals for testing)
SYNC_INTERVAL=60
THERMOWORKS_POLLING_INTERVAL=30

# Development Features
ENABLE_CORS=true
DEVELOPMENT_MODE=true
AUTO_RELOAD=true

# Mock Data Settings
MOCK_UPDATE_INTERVAL=10
MOCK_DATA_DIR=services/mock_data