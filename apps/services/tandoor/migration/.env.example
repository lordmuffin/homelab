# Microsoft Graph API Credentials
# Get these from Azure App Registration
MICROSOFT_CLIENT_ID=your_client_id_here
MICROSOFT_CLIENT_SECRET=your_client_secret_here
MICROSOFT_TENANT_ID=your_tenant_id_here

# Tandoor API Configuration
TANDOOR_URL=https://recipes.yourdomain.com
TANDOOR_API_TOKEN=your_tandoor_api_token

# Migration Settings
ONENOTE_NOTEBOOK_NAME=Recipes
BATCH_SIZE=10
DELAY_BETWEEN_REQUESTS=1.0
SKIP_DUPLICATES=true
MIN_INGREDIENTS=2
MIN_INSTRUCTIONS=2

# Image Processing
DOWNLOAD_IMAGES=true
MAX_IMAGE_SIZE_MB=10

# Execution Mode
DRY_RUN=false

# Logging
LOG_LEVEL=INFO
LOG_FILE=migration.log
LOG_CONSOLE=true

# Output Files
SUCCESS_REPORT_FILE=migration_success.json
ERROR_REPORT_FILE=migration_errors.json