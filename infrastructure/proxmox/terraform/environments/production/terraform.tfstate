  "resources": [
    {
      "module": "module.k3s_cluster_pve2",
      "mode": "managed",
      "type": "local_file",
      "name": "cloud_init_configs",
      "provider": "provider[\"registry.terraform.io/hashicorp/local\"]",
      "instances": [
        {
          "index_key": "gpu-workers-pve2-1",
          "schema_version": 0,
          "attributes": {
            "content": "#cloud-config\r\n# K3s HA Cluster Cloud-Init Configuration\r\n# Hostname: k3s-gpu-workers-pve2-1\r\n# VM Type: gpu-workers\r\n# Environment: prod\r\n\r\nhostname: k3s-gpu-workers-pve2-1\r\nmanage_etc_hosts: true\r\n\r\n# User configuration\r\nusers:\r\n  - name: ubuntu\r\n    groups: [adm, cdrom, dip, plugdev, lxd, sudo]\r\n    lock_passwd: false\r\n    shell: /bin/bash\r\n    ssh_authorized_keys:\r\n      - ssh-rsa \r\n    sudo: ALL=(ALL) NOPASSWD:ALL\r\n\r\n# System packages\r\npackages:\r\n  - curl\r\n  - wget\r\n  - git\r\n  - htop\r\n  - iotop\r\n  - iftop\r\n  - ncdu\r\n  - net-tools\r\n  - unzip\r\n  - jq\r\n  - nfs-common\r\n  - open-iscsi\r\n  - util-linux\r\n  - cryptsetup\r\n  - lvm2\r\n\r\n\r\n# System configuration\r\nwrite_files:\r\n  # K3s configuration\r\n  - path: /etc/k3s-config.yaml\r\n    content: |\r\n      cluster-init: false\r\n      server: \r\n      token: MD7VSWru58GKUOPPdhP0JUeMNsYQnMfQ\r\n      disable:\r\n        - servicelb  # Use MetalLB instead\r\n        - traefik    # Use existing Traefik\r\n      tls-san:\r\n        - k3s-vip.cluster.local\r\n        - 10.10.100.50\r\n\r\n\r\n\r\n    permissions: '0644'\r\n\r\n  # K3s installation script\r\n  - path: /usr/local/bin/install-k3s.sh\r\n    content: |\r\n      #!/bin/bash\r\n      set -euo pipefail\r\n      \r\n      echo \"Installing K3s on k3s-gpu-workers-pve2-1...\"\r\n      \r\n      # Wait for system to be ready\r\n      sleep 30\r\n      \r\n      # Install K3s\r\n      curl -sfL https://get.k3s.io | sh -s - \\\r\n        --config /etc/k3s-config.yaml \\\r\n\r\n\r\n        --write-kubeconfig-mode 644\r\n      \r\n      # Enable and start K3s\r\n      systemctl enable k3s\r\n      systemctl start k3s\r\n      \r\n      # Wait for K3s to be ready\r\n      until kubectl get nodes; do\r\n        echo \"Waiting for K3s to be ready...\"\r\n        sleep 10\r\n      done\r\n      \r\n      echo \"K3s installation completed on k3s-gpu-workers-pve2-1\"\r\n    permissions: '0755'\r\n\r\n  # System optimization for K3s\r\n  - path: /etc/sysctl.d/99-k3s.conf\r\n    content: |\r\n      # K3s system optimizations\r\n      net.bridge.bridge-nf-call-iptables = 1\r\n      net.bridge.bridge-nf-call-ip6tables = 1\r\n      net.ipv4.ip_forward = 1\r\n      vm.swappiness = 1\r\n      vm.overcommit_memory = 1\r\n      kernel.panic = 10\r\n      kernel.panic_on_oops = 1\r\n    permissions: '0644'\r\n\r\n  # Logrotate configuration for K3s\r\n  - path: /etc/logrotate.d/k3s\r\n    content: |\r\n      /var/log/k3s.log {\r\n        daily\r\n        missingok\r\n        rotate 7\r\n        compress\r\n        notifempty\r\n        create 644 root root\r\n        postrotate\r\n          systemctl reload k3s || true\r\n        endscript\r\n      }\r\n    permissions: '0644'\r\n\r\n\r\n\r\n# Boot commands\r\nbootcmd:\r\n  - echo 'APT::Periodic::Update-Package-Lists \"1\";' \u003e /etc/apt/apt.conf.d/20auto-upgrades\r\n  - echo 'APT::Periodic::Unattended-Upgrade \"1\";' \u003e\u003e /etc/apt/apt.conf.d/20auto-upgrades\r\n\r\n# Run commands\r\nruncmd:\r\n  # Update system\r\n  - apt-get update\r\n  - apt-get upgrade -y\r\n  \r\n  # Apply sysctl settings\r\n  - sysctl --system\r\n  \r\n  # Enable and configure services\r\n  - systemctl enable iscsid\r\n  - systemctl start iscsid\r\n  \r\n\r\n  \r\n  # Install K3s (delayed to ensure system is ready)\r\n  - sleep 60\r\n  - /usr/local/bin/install-k3s.sh\r\n  \r\n  # Log completion\r\n  - echo \"Cloud-init completed for k3s-gpu-workers-pve2-1 at $(date)\" \u003e\u003e /var/log/cloud-init-custom.log\r\n\r\n# Final message\r\nfinal_message: |\r\n  K3s node k3s-gpu-workers-pve2-1 (gpu-workers) is ready!\r\n  Environment: prod\r\n  VM Type: gpu-workers\r\n  Primary: false\r\n  \r\n  System information:\r\n  - OS: Ubuntu 22.04 LTS\r\n  - K3s: Latest stable\r\n  - Hostname: k3s-gpu-workers-pve2-1\r\n  \r\n  The system is ready for K3s cluster operations.\r\n\r\n# Reboot after cloud-init completion\r\npower_state:\r\n  mode: reboot\r\n  delay: now\r\n  condition: true",
            "content_base64": null,
            "content_base64sha256": "50wG2KcckaOcTR77OVO6CCd95lhKqlYRx9wgMJiUhSQ=",
            "content_base64sha512": "iLBNZE5lPaJDkdf7RztmxP7htkOMK5XL9uzMAHusHO2o++Rd962oTfk5h239/nvUGkizVThDGXcDKHorIlLyaw==",
