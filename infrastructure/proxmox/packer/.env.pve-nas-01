# Proxmox Environment Variables for Packer - PVE-NAS-01 Node
# Copy this file to .env.pve-nas-01 and fill in your values

# Proxmox API URL (include https:// and :8006)
PROXMOX_URL=https://192.168.1.15:8006/api2/json

# Proxmox Node Name
PROXMOX_NODE=pve-nas-01

# Proxmox Authentication - Use EITHER token OR username/password
# Token authentication (recommended)
PROXMOX_USERNAME=terraform@pve!terraform
PROXMOX_TOKEN=74bb1806-b743-459b-bfc1-3734f862030b

# OR Password authentication (less secure)
# PROXMOX_USERNAME=your-username@pam
# PROXMOX_PASSWORD=your-password

# Template Configuration
TEMPLATE_ID=9002
TEMPLATE_NAME=ubuntu-k3s-homelab-template-nas

# Export these variables before running packer:
# source .env.pve-nas-01 && packer build ubuntu-k3s.pkr.hcl