# Proxmox Environment Variables for Packer - DEPRECATED
# 
# ⚠️  This file is deprecated! Use node-specific environment files instead:
# 
# For multi-node setup, use:
# - .env.pve.example       → Copy to .env.pve for PVE node
# - .env.pve2.example      → Copy to .env.pve2 for PVE2 node  
# - .env.pve-nas-01.example → Copy to .env.pve-nas-01 for NAS node
#
# Then run: ./build-all-templates.sh
#
# ===================================================================
# LEGACY CONFIGURATION (for single node builds only)
# ===================================================================

# Proxmox API URL (include https:// and :8006)
PROXMOX_URL=https://192.168.1.14:8006/api2/json

# Proxmox Node Name
PROXMOX_NODE=pve2

# Proxmox Authentication - Use EITHER token OR username/password
# Token authentication (recommended)
PROXMOX_USERNAME=root@pam!packer
PROXMOX_TOKEN=0dd55215-4ce9-41e6-8529-c181e17765bc

# OR Password authentication (less secure)
# PROXMOX_USERNAME=your-username@pam
# PROXMOX_PASSWORD=your-password

# Template Configuration
TEMPLATE_ID=9001
TEMPLATE_NAME=ubuntu-k3s-homelab-template-pve2

# Export these variables before running packer:
# source .env && packer build ubuntu-k3s.pkr.hcl