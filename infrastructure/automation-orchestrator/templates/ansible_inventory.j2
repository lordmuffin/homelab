# Ansible Inventory Template
# This template generates dynamic Ansible inventory files
# Generated by Automation Orchestrator at {{ generated_at }}

# =============================================================================
# ALL HOSTS
# =============================================================================
all:
  vars:
    # Global variables for all hosts
    ansible_user: admin
    ansible_ssh_common_args: '-o StrictHostKeyChecking=no'
    orchestrator_managed: true
    inventory_generated_at: "{{ generated_at }}"
  
  children:
{% if groups %}
{% for group_name in groups %}
    {{ group_name }}:
{% endfor %}
{% endif %}

# =============================================================================  
# HOST GROUPS
# =============================================================================
{% for group_name, group_data in groups.items() %}
{% if group_data.hosts %}
{{ group_name }}:
  hosts:
{% for host in group_data.hosts %}
    {{ host.inventory_hostname }}:
      ansible_host: {{ host.ansible_host }}
{% if host.ansible_port %}
      ansible_port: {{ host.ansible_port }}
{% endif %}
{% if host.ansible_connection %}
      ansible_connection: {{ host.ansible_connection }}
{% endif %}
{% if host.discovered_hostname %}
      discovered_hostname: {{ host.discovered_hostname }}
{% endif %}
{% if host.location %}
      location: {{ host.location }}
{% endif %}
{% if host.has_gpu %}
      has_gpu: {{ host.has_gpu }}
      gpu_type: {{ host.gpu_type }}
{% if host.gpu_count %}
      gpu_count: {{ host.gpu_count }}
{% endif %}
{% endif %}
{% if host.services %}
      services: {{ host.services | to_json }}
{% endif %}
{% if host.host_type %}
      host_type: {{ host.host_type }}
{% endif %}
{% if host.memory_gb %}
      memory_gb: {{ host.memory_gb }}
{% endif %}
{% if host.cpu_cores %}
      cpu_cores: {{ host.cpu_cores }}
{% endif %}
{% endfor %}

{% if group_data.vars %}
  vars:
{% for var_name, var_value in group_data.vars.items() %}
    {{ var_name }}: {{ var_value | to_yaml }}
{% endfor %}
{% endif %}

{% endif %}
{% endfor %}

# =============================================================================
# SPECIAL GROUPS
# =============================================================================

# GPU-enabled hosts for AI/ML workloads
{% if ai_nodes %}
ai_nodes:
  hosts:
{% for host in ai_nodes %}
    {{ host.inventory_hostname }}:
{% endfor %}
  vars:
    nvidia_docker_runtime: true
    cuda_enabled: true
    install_nvidia_drivers: true
    docker_daemon_options:
      default-runtime: nvidia
{% endif %}

# Kubernetes cluster nodes
{% if k8s_nodes %}
kubernetes:
  children:
    k8s_masters:
    k8s_workers:
  vars:
    k8s_cluster_name: homelab
    k8s_version: v1.28.0
    
k8s_masters:
  hosts:
{% for host in k8s_masters %}
    {{ host.inventory_hostname }}:
{% endfor %}
  vars:
    k8s_role: master
    k8s_allow_schedule: false
    
k8s_workers:
  hosts:
{% for host in k8s_workers %}
    {{ host.inventory_hostname }}:
{% endfor %}
  vars:
    k8s_role: worker
{% endif %}

# Storage systems
{% if storage_nodes %}
storage:
  hosts:
{% for host in storage_nodes %}
    {{ host.inventory_hostname }}:
{% endfor %}
  vars:
    nfs_exports_enabled: true
    backup_enabled: true
    monitoring_enabled: true
{% endif %}

# Monitoring infrastructure  
{% if monitoring_nodes %}
monitoring:
  hosts:
{% for host in monitoring_nodes %}
    {{ host.inventory_hostname }}:
{% endfor %}
  vars:
    prometheus_enabled: true
    grafana_enabled: true
    node_exporter_enabled: true
    alertmanager_enabled: true
{% endif %}

# Database servers
{% if database_servers %}
databases:
  hosts:
{% for host in database_servers %}
    {{ host.inventory_hostname }}:
{% endfor %}
  vars:
    backup_enabled: true
    monitoring_enabled: true
    firewall_strict: true
{% endif %}

# Web servers
{% if web_servers %}
webservers:
  hosts:
{% for host in web_servers %}
    {{ host.inventory_hostname }}:
{% endfor %}
  vars:
    ssl_enabled: true
    monitoring_enabled: true
    backup_configs: true
{% endif %}

# =============================================================================
# ENVIRONMENT GROUPS
# ============================================================================= 

{% if production_hosts %}
production:
  hosts:
{% for host in production_hosts %}
    {{ host.inventory_hostname }}:
{% endfor %}
  vars:
    environment: production
    backup_required: true
    monitoring_level: critical
    update_schedule: maintenance_window
{% endif %}

{% if staging_hosts %}
staging:
  hosts:
{% for host in staging_hosts %}
    {{ host.inventory_hostname }}:
{% endfor %}
  vars:
    environment: staging  
    backup_required: false
    monitoring_level: standard
{% endif %}

{% if development_hosts %}
development:
  hosts:
{% for host in development_hosts %}
    {{ host.inventory_hostname }}:
{% endfor %}
  vars:
    environment: development
    backup_required: false
    monitoring_level: basic
    auto_update: true
{% endif %}

# =============================================================================
# LOCATION GROUPS
# =============================================================================

{% for location, hosts in locations.items() %}
{{ location | lower | replace(' ', '_') }}:
  hosts:
{% for host in hosts %}
    {{ host.inventory_hostname }}:
{% endfor %}
  vars:
    location: "{{ location }}"
{% if location == "Home Lab" %}
    network_type: "private"
    internet_access: true
{% elif location == "Data Center" %}
    network_type: "enterprise" 
    internet_access: true
    backup_offsite: true
{% endif %}

{% endfor %}

# =============================================================================
# CUSTOM METADATA (for reference)
# =============================================================================

# This inventory was generated from {{ total_assets }} discovered assets
# Discovery methods: {{ discovery_methods | join(', ') }}
# Generated with Automation Orchestrator
# 
# Asset breakdown:
{% for asset_type, count in asset_types.items() %}
#   - {{ asset_type }}: {{ count }} hosts
{% endfor %}
#
# Service summary:
{% for service, count in service_summary.items() %}
#   - {{ service }}: {{ count }} instances  
{% endfor %}